<?xml version="1.0" encoding="utf-8"?>
<!--
    Dev flavour only. The 5a row view parity harness, started with
    adb shell am start -n com.fs.twitchminichat.dev/com.fs.twitchminichat.harness.RowViewParityHarnessActivity
    Exported so that adb can start it, and guarded so that only adb can: starting it
    requires android.permission.DUMP, which the shell holds and an ordinary app cannot
    be granted. It renders fixed rows and writes only under its own files/parity-harness.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <activity
            android:name="com.fs.twitchminichat.harness.RowViewParityHarnessActivity"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:theme="@style/Theme.TwitchMiniChat" />
    </application>

</manifest>
