<?xml version="1.0" encoding="utf-8"?>
<!--
    The Bug report page: where to report, what to include, and the installed version to
    copy. It offers no diagnostics export and does not mention the hidden gesture
    (Federico, 2026-11-12). Every control is at least 48 dp and carries a content
    description.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/textBugReportWhere"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/bug_report_include"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/bug_report_diagnostics"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/bug_report_never_share"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textBugReportVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textIsSelectable="true"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnBugReportDiscord"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:contentDescription="@string/welcome_discord_description"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:text="@string/bug_report_open_discord" />

        <Button
            android:id="@+id/btnBugReportClose"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:contentDescription="@string/welcome_close"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:text="@string/welcome_close" />
    </LinearLayout>
</ScrollView>
