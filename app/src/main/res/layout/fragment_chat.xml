<?xml version="1.0" encoding="utf-8"?>
<!--
    Prototype 5d-layout-b, not for merging. The root shares its height at measure time
    (ChatPageLayout, ChatPagePolicy): the composer row always stays on screen, the player keeps
    its full height or is refused, and the picker shrinks toward its minimum before the list
    goes below its floor.
-->
<com.fs.twitchminichat.ui.page.ChatPageLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootChat"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="true"
    app:chatPageListId="@+id/chatListFrame"
    app:chatPagePlayerId="@+id/geckoStreamView"
    app:chatPagePickerId="@+id/emotePickerPanel"
    app:chatPagePickerMinHeight="@dimen/chat_page_picker_min_height">

    <LinearLayout
        android:id="@+id/channelSwitchBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <com.fs.twitchminichat.ChannelAutoCompleteTextView
            android:id="@+id/editChannel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/hint_channel_name"
            android:inputType="text"
            android:singleLine="true"
            android:autofillHints=""
            android:minHeight="48dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <!-- The connection: an indicator, then the user name and the channel, read as one item. -->
        <LinearLayout
            android:id="@+id/statusCluster"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="4dp"
            android:focusable="true"
            android:contentDescription="@string/status_state_disconnected">

            <ImageView
                android:id="@+id/imgStatusIndicator"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                android:contentDescription="@string/status_state_disconnected"
                android:src="@drawable/ic_status_disconnected" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textStatusUser"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:importantForAccessibility="no"
                    android:maxLines="1"
                    android:maxWidth="@dimen/chat_status_names_max_width"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/textStatusChannel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:importantForAccessibility="no"
                    android:maxLines="1"
                    android:maxWidth="@dimen/chat_status_names_max_width"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnMuteStream"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/unmute_stream"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:src="@drawable/ic_volume_off_24"
            android:visibility="gone"
            app:tint="?attr/colorOnSurface" />


        <ImageButton
            android:id="@+id/btnRefreshChat"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:padding="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/refresh_chat"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:src="@android:drawable/ic_popup_sync"
            app:tint="?attr/colorOnSurface" />

        <ImageButton
            android:id="@+id/btnTogglePush"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/account_notifications"
            android:src="@android:drawable/ic_lock_silent_mode_off" />
        <ImageButton
            android:id="@+id/btnSafetyPrivacy"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:padding="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/safety_privacy"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:src="@android:drawable/ic_menu_info_details"
            app:tint="?attr/colorOnSurface" />

    </LinearLayout>

    <!-- Shown only for the problem states, with their words: what happened, and what to do. -->
    <TextView
        android:id="@+id/textStatusProblem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp"
        android:textStyle="bold"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/topActionsRow"
        style="?android:attr/buttonBarStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="8dp">

        <Button
            android:id="@+id/btnStartPcg"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:text="@string/start_pcg" />

        <Button
            android:id="@+id/btnToggleStream"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:minHeight="48dp"
            android:text="@string/stream_off" />
    </LinearLayout>

    <org.mozilla.geckoview.GeckoView
        android:id="@+id/geckoStreamView"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:visibility="gone"
        android:contentDescription="@string/stream_player" />
    <FrameLayout
        android:id="@+id/chatListFrame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!--
            The chat timeline. Its rows sit and scroll inside the 12 dp the old container's
            padding gave them: clipToPadding="false" lets them scroll through it. The ScrollView
            showed a vertical scroll bar by its style; a RecyclerView shows one only when asked.
        -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/chatList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="12dp"
            android:scrollbars="vertical"
            android:contentDescription="@string/chat_messages" />

        <Button
            android:id="@+id/btnJumpToBottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="12dp"
            android:text="@string/new_messages"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/replyBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/txtReplyInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/replying"
            android:maxLines="2" />

        <Button
            android:id="@+id/btnCancelReply"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/reply_cancel"/>
    </LinearLayout>

    <include layout="@layout/view_twitch_emote_picker" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="6dp">

        <com.fs.twitchminichat.ui.input.ChatMessageInputView
            android:id="@+id/editMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:autofillHints=""
            android:hint="@string/hint_write_here"
            android:imeOptions="actionSend"
            android:inputType="text"
            android:minHeight="48dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:singleLine="true" />

        <ImageButton
            android:id="@+id/btnEmotes"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/emote_picker_open"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:padding="11dp"
            android:src="@drawable/ic_emote_24"
            app:tint="?attr/colorOnSurface" />

        <Button
            android:id="@+id/btnSend"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:minWidth="56dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/send" />

        <ImageButton
            android:id="@+id/btnCatchPresets"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/catch_presets"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_pokeball"
            app:tint="@null" />

        </LinearLayout>

</com.fs.twitchminichat.ui.page.ChatPageLayout>