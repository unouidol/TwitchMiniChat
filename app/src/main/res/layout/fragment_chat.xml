<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootChat"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <LinearLayout
        android:id="@+id/channelSwitchBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp">

        <com.fs.twitchminichat.ChannelAutoCompleteTextView
            android:id="@+id/editChannel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/hint_channel_name"
            android:inputType="text"
            android:singleLine="true"
            android:autofillHints=""
            android:minHeight="48dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />


        <ImageButton
            android:id="@+id/btnRefreshChat"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:padding="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/refresh_chat"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:src="@android:drawable/ic_popup_sync"
            app:tint="?attr/colorOnSurface" />

        <ImageButton
            android:id="@+id/btnTogglePush"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/account_notifications"
            android:src="@android:drawable/ic_lock_silent_mode_off" />
        <ImageButton
            android:id="@+id/btnSafetyPrivacy"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:padding="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/safety_privacy"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:src="@android:drawable/ic_menu_info_details"
            app:tint="?attr/colorOnSurface" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/topActionsRow"
        style="?android:attr/buttonBarStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="8dp">

        <Button
            android:id="@+id/btnStartPcg"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:text="@string/start_pcg" />

        <Button
            android:id="@+id/btnToggleStream"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:minHeight="48dp"
            android:text="@string/stream_off" />
    </LinearLayout>

    <TextView
        android:id="@+id/textStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:text="@string/status_disconnected"
        android:textStyle="bold" />
    <LinearLayout
        android:id="@+id/streamControlsBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp">

        <Button
            android:id="@+id/btnMuteStream"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/unmute"
            android:visibility="gone" />
    </LinearLayout>

    <org.mozilla.geckoview.GeckoView
        android:id="@+id/geckoStreamView"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:visibility="gone"
        android:contentDescription="@string/stream_player" />
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/scrollChat"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:contentDescription="@string/chat_messages">

            <LinearLayout
                android:id="@+id/chatContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp" />
        </ScrollView>

        <Button
            android:id="@+id/btnJumpToBottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="12dp"
            android:text="@string/new_messages"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/replyBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/txtReplyInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/replying"
            android:maxLines="2" />

        <Button
            android:id="@+id/btnCancelReply"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/reply_cancel"/>
    </LinearLayout>

    <include layout="@layout/view_twitch_emote_picker" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="6dp">

        <com.fs.twitchminichat.ui.input.ChatMessageInputView
            android:id="@+id/editMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:autofillHints=""
            android:hint="@string/hint_write_here"
            android:imeOptions="actionSend"
            android:inputType="text"
            android:minHeight="48dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:singleLine="true" />

        <ImageButton
            android:id="@+id/btnEmotes"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/emote_picker_open"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:padding="11dp"
            android:src="@drawable/ic_emote_24"
            app:tint="?attr/colorOnSurface" />

        <Button
            android:id="@+id/btnSend"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:minWidth="56dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/send" />

        <ImageButton
            android:id="@+id/btnCatchPresets"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/catch_presets"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_pokeball"
            app:tint="@null" />

        </LinearLayout>

</LinearLayout>