<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/safetyPrivacyRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/textSafetyTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/safety_privacy_title"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textSafetySubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/safety_privacy_subtitle"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnReportBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/report_block" />

        <Button
            android:id="@+id/btnBlockedUsers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/blocked_users" />

        <Button
            android:id="@+id/btnPrivacyPolicy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/privacy_policy" />

        <Button
            android:id="@+id/btnTerms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/terms_of_use" />

        <Button
            android:id="@+id/btnDataControl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/data_account_control" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchCrashReporting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/crash_reporting_switch" />

        <TextView
            android:id="@+id/textCrashReportingNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/crash_reporting_note"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/textExternalLinksTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/external_links_title"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textExternalLinksSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/external_links_subtitle"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnResetExternalLinkPreferences"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/external_link_reset_preferences" />

        <Button
            android:id="@+id/btnCredits"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/credits" />

        <!--
            The "about" group, last and away from Report & Block. That entry reports a chat
            message, and Bug report beside it would be easy to tap for it.
        -->
        <Button
            android:id="@+id/btnAboutTmc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:contentDescription="@string/about_tmc"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:text="@string/about_tmc" />

        <Button
            android:id="@+id/btnBugReport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:contentDescription="@string/bug_report"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:text="@string/bug_report" />

    </LinearLayout>
</ScrollView>
