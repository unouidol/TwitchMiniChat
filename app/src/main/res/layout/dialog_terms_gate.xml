<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/textTermsIntro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Before using TwitchMiniChat, you must review and accept the Terms of Use and Privacy Policy."
            android:textSize="16sp" />

        <TextView
            android:id="@+id/textTermsNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="TwitchMiniChat provides access to public Twitch chat content and includes in-app safety tools such as message reporting and user blocking."
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnOpenTermsFromGate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Open Terms of Use" />

        <Button
            android:id="@+id/btnOpenPrivacyFromGate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Open Privacy Policy" />

        <CheckBox
            android:id="@+id/checkAcceptTerms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="I have read and agree to the Terms of Use and Privacy Policy." />

    </LinearLayout>
</ScrollView>