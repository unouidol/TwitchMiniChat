<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/textTermsIntro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/terms_gate_intro"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/textTermsNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/terms_gate_note"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/textTermsCrashReporting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/terms_gate_crash_reporting"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnOpenTermsFromGate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/open_terms_of_use" />

        <Button
            android:id="@+id/btnOpenPrivacyFromGate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/open_privacy_policy" />

        <CheckBox
            android:id="@+id/checkAcceptTerms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/terms_gate_accept_checkbox" />

    </LinearLayout>
</ScrollView>