<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/txtPresetIndex"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnDragPreset"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/drag_to_reorder_preset"
            android:padding="12dp"
            android:src="@android:drawable/ic_menu_sort_by_size"
            app:tint="@android:color/white" />

        <ImageButton
            android:id="@+id/btnRemovePreset"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/remove_preset"
            android:padding="12dp"
            android:src="@android:drawable/ic_menu_delete"
            app:tint="@android:color/white" />
    </LinearLayout>

    <CheckBox
        android:id="@+id/checkPresetEnabled"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/catch_preset_enabled" />

    <EditText
        android:id="@+id/editPresetLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:hint="@string/catch_preset_label_hint"
        android:inputType="text"
        android:maxLines="1" />

    <EditText
        android:id="@+id/editPresetCommand"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:hint="@string/catch_preset_command_hint"
        android:inputType="text"
        android:maxLines="1" />

</LinearLayout>