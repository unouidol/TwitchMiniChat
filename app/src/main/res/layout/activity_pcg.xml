<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/pcgActivityRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/layoutPcgManualUpdateBar"
        style="?android:attr/buttonBarStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="6dp"
        android:paddingEnd="8dp"
        android:paddingBottom="6dp">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnRegisterInventory"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:gravity="center"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:text="@string/pcg_register_inventory"
            android:textSize="12sp"
            android:drawablePadding="6dp"
            app:drawableStartCompat="@drawable/ic_bag_black_24" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnRegisterPokedex"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:gravity="center"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:text="@string/pcg_register_pokedex"
            android:textSize="12sp"
            android:drawablePadding="6dp"
            app:drawableStartCompat="@drawable/ic_pokedex_24"
            app:drawableTint="?android:attr/textColorPrimary" />

    </LinearLayout>

    <FrameLayout
        android:id="@+id/pcgContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>