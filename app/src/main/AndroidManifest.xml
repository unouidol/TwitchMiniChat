<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TwitchMiniChat">

        <activity
            android:name="com.fs.twitchminichat.pcg.PcgActivity"
            android:exported="false" />

        <activity
            android:name="com.fs.twitchminichat.AuthCallbackActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:scheme="${authScheme}"
                    android:host="auth" />
            </intent-filter>

        </activity>

        <activity
            android:name="com.fs.twitchminichat.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.TwitchMiniChat"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".SafetyPrivacyActivity" />
        <activity android:name=".BlockedUsersActivity" />

        <service
            android:name="com.fs.twitchminichat.MyFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

    </application>

</manifest>
