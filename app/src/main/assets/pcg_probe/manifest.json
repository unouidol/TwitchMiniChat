{
  "manifest_version": 2,
  "name": "PCG Probe",
  "version": "1.2",
  "browser_specific_settings": {
    "gecko": {
      "id": "pcg-probe@example.com"
    }
  },
  "permissions": [
    "nativeMessaging",
    "nativeMessagingFromContent",
    "geckoViewAddons"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.ext-twitch.tv/*"
      ],
      "exclude_matches": [
        "https://supervisor.ext-twitch.tv/*"
      ],
      "all_frames": true,
      "run_at": "document_idle",
      "js": [
        "content.js",
        "pcg_probe_inventory.js"
      ]
    }
  ]
}